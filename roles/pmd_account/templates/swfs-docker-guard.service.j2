[Unit]
Description=swfs-docker-guard ({{ inventory_hostname }}): stops the provider's rootless Docker of this account (started by swfs-docker-guard.path)
# many Docker files appear in a burst; this is a cheap one-shot, so never rate-limit the path unit's trigger
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 {{ pmd_bin_dir }}/swfs-docker-guard.py{% if not (pmd_docker_guard_act | bool) %} --observe{% endif %}

UMask=0077
Nice=10
OOMScoreAdjust=950
StandardOutput=append:{{ pmd_log_dir }}/docker-guard.log
StandardError=append:{{ pmd_log_dir }}/docker-guard.log
