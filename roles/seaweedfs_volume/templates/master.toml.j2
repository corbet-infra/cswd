# managed by corbet.cswd.seaweedfs_volume. No EC (the free version is a fixed 10+4 and needs 14 servers): replication repair, balance,
# empty-volume removal and upload cleanup only. Vacuum is the master's own periodic job (-garbageThreshold).
[master.maintenance]
scripts = """
{{ seaweed_master_scripts | indent(2, true) }}
"""
sleep_minutes = {{ seaweed_master_sleep_minutes }}
[master.volume_growth]
copy_1 = 2
copy_2 = 2
copy_3 = 1
copy_other = 1
