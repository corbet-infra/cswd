[Unit]
Description=SeaweedFS filer with S3 gateway ({{ inventory_hostname }})

[Service]
Type=simple
Environment=HOME={{ ansible_facts['user_dir'] }}
Environment=GOMEMLIMIT={{ seaweed_gomemlimit_filer }}
WorkingDirectory={{ seaweed_base_dir }}/data/seaweed-filer
ExecStart={{ seaweed_bin_dir }}/weed-{{ seaweed_version }}/weed -logtostderr filer \
  -ip={{ seaweed_public_ip }} -ip.bind=0.0.0.0 -port={{ seaweed_filer_http_port }} -port.grpc={{ seaweed_filer_grpc_port }} \
  -master={{ seaweed_master }} -dataCenter={{ seaweed_data_center }} -rack={{ seaweed_rack }} -defaultStoreDir={{ seaweed_base_dir }}/data/seaweed-filer/ldb
Restart=always
RestartSec=10
UMask=0077
StandardError=append:{{ seaweed_log_dir }}/filer.log
OOMScoreAdjust={{ seaweed_oom_filer }}
Nice=5

[Install]
WantedBy=default.target
