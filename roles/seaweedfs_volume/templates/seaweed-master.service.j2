[Unit]
Description=SeaweedFS master ({{ inventory_hostname }})

[Service]
Type=simple
Environment=HOME={{ ansible_facts['user_dir'] }}
Environment=GOMEMLIMIT={{ seaweed_gomemlimit_master }}
ExecStart={{ seaweed_bin_dir }}/weed-{{ seaweed_version }}/weed -logtostderr master -telemetry=false \
  -ip={{ seaweed_public_ip }} -ip.bind=0.0.0.0 -port={{ seaweed_master_http_port }} -port.grpc={{ seaweed_master_grpc_port }} \
  -mdir={{ seaweed_base_dir }}/data/seaweed-master -volumeSizeLimitMB={{ seaweed_volume_size_limit_mb }} \
  -defaultReplication={{ seaweed_default_replication }} -garbageThreshold=0.3 -volumePreallocate=false \
  {{ ('-peers=' ~ seaweed_master_peers) if seaweed_master_peers else '' }}
Restart=always
RestartSec=10
UMask=0077
StandardError=append:{{ seaweed_log_dir }}/master.log
OOMScoreAdjust={{ seaweed_oom_master }}
Nice=5

[Install]
WantedBy=default.target
