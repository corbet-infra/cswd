[Unit]
Description=SeaweedFS S3 gateway ({{ inventory_hostname }}), a separate process because the embedded gateway dials the filer at HTTP port + 10000
After=seaweed-filer.service

[Service]
Type=simple
Environment=HOME={{ ansible_facts['user_dir'] }}
Environment=GOMEMLIMIT={{ seaweed_gomemlimit_s3 }}
{%% if seaweed_disable_thp | bool %%}Environment=GODEBUG=disablethp=1
{%% endif %%}{% if seaweed_limitdata_s3 | string | length > 0 %}LimitDATA={{ seaweed_limitdata_s3 }}
{% endif %}ExecStart={{ seaweed_bin_dir }}/weed-{{ seaweed_version }}/weed -logtostderr s3 \
  -filer={{ seaweed_public_ip }}:{{ seaweed_filer_http_port }}.{{ seaweed_filer_grpc_port }} -ip.bind=0.0.0.0 \
  -port=0 -port.https={{ seaweed_s3_https_port }} -port.grpc={{ seaweed_s3_grpc_port }} -port.iceberg=0 -port.lance=0 \
  -cert.file={{ seaweed_tls_dir }}/cert.pem -key.file={{ seaweed_tls_dir }}/key.pem -config={{ ansible_facts['user_dir'] }}/.seaweedfs/s3.json \
  -cacheCapacityMB={{ seaweed_s3_cache_mb }} -readerCacheSizeMB={{ seaweed_s3_reader_cache_mb }} -concurrentUploadLimitMB={{ seaweed_s3_upload_limit_mb }} -concurrentFileUploadLimit={{ seaweed_s3_upload_files }}
StandardError=append:{{ seaweed_log_dir }}/s3.log
Restart=always
RestartSec=10
UMask=0077
OOMScoreAdjust={{ seaweed_oom_s3 }}
Nice=5

[Install]
WantedBy=default.target
