# {{ ansible_managed | default('managed by corbet.cswd.seaweedfs_volume') }}
# Mutual TLS on gRPC (master <-> volume <-> filer) and HTTPS on the volume server with client certificates, all from the cluster CA.
[jwt.signing]
key = "{{ lookup('corbet.cpmd.sops', seaweed_jwt_sops_file, seaweed_jwt_sops_key) if seaweed_jwt_sops_file | length > 0 else '' }}"

[grpc]
ca = "{{ seaweed_tls_dir }}/ca.pem"

[grpc.volume]
cert = "{{ seaweed_tls_dir }}/cert.pem"
key = "{{ seaweed_tls_dir }}/key.pem"

[grpc.client]
cert = "{{ seaweed_tls_dir }}/cert.pem"
key = "{{ seaweed_tls_dir }}/key.pem"

[https.volume]
cert = "{{ seaweed_tls_dir }}/cert.pem"
key = "{{ seaweed_tls_dir }}/key.pem"
ca = "{{ seaweed_tls_dir }}/ca.pem"

[https.client]
enabled = true
cert = "{{ seaweed_tls_dir }}/cert.pem"
key = "{{ seaweed_tls_dir }}/key.pem"
ca = "{{ seaweed_tls_dir }}/ca.pem"

[grpc.master]
cert = "{{ seaweed_tls_dir }}/cert.pem"
key = "{{ seaweed_tls_dir }}/key.pem"

[grpc.filer]
cert = "{{ seaweed_tls_dir }}/cert.pem"
key = "{{ seaweed_tls_dir }}/key.pem"

[https.filer]
cert = "{{ seaweed_tls_dir }}/cert.pem"
key = "{{ seaweed_tls_dir }}/key.pem"
